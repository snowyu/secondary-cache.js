{
  "include": ["src/**/*"],
  "compilerOptions": {
    "allowJs": true,
    "declaration": true,
    "esModuleInterop": true,
    "module": "CommonJS",
    "lib": ["ES2018"],
    "target": "ES6",
    // tsup handles .d.ts generation via dts:true;
    // tsconfig is kept for IDE language service support
    "emitDeclarationOnly": true,
    "outDir": "types"
  },
  "typedocOptions": {
    "entryPoints": ["src/*.js"],
    "out": "docs"
  },
  "exclude": ["**/*.spec.js", "**/*.test.js"]
}
